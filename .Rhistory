View(confirmacion_dia)
# Check for daily confirmations without a weekly parent
confirmacion_dia |>
anti_join(
confirmaciones_semanal,
by = c("vol_id", "semana", "bloque")
)
# Check for daily confirmations without a weekly parent
confirmacion_dia |>
anti_join(
confirmacion_semanal,
by = c("vol_id", "semana", "bloque")
)
