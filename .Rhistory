unnest(cols = dias) |>
select(id, Martes, Jueves, Viernes, Miércoles, Lunes) |>
mutate(across(
-id,
~ case_when(
is.na(.x) ~ "MISSING (NA)",
.x == "" ~ "EMPTY STRING",
TRUE ~ .x
)
))
# look at missingness across all weeks in dias
old_data$confirm |>
unnest(cols = dias) |>
pivot_longer(-id, names_to = "dia", values_to = "estado") |>
mutate(estado = case_when(is.na(estado) ~ "MISSING (NA)",
estado == "" ~ "EMPTY STRING",
TRUE ~ estado))
# look at missingness across all weeks in dias
old_data$confirm |>
select(id, volId, dias) |>
unnest(cols = dias) |>
pivot_longer(-id, names_to = "dia", values_to = "estado") |>
mutate(estado = case_when(is.na(estado) ~ "MISSING (NA)",
estado == "" ~ "EMPTY STRING",
TRUE ~ estado))
old_data$confirm <- old_data$confirm |>
mutate(volId = as.character(volId))
# look at missingness across all weeks in dias
old_data$confirm |>
select(id, volId, dias) |>
unnest(cols = dias) |>
pivot_longer(-id, names_to = "dia", values_to = "estado") |>
mutate(estado = case_when(is.na(estado) ~ "MISSING (NA)",
estado == "" ~ "EMPTY STRING",
TRUE ~ estado))
# look at missingness across all weeks in dias
old_data$confirm |>
select(id, volId, dias) |>
unnest(cols = dias) |>
pivot_longer(c(-id,-volId), names_to = "dia", values_to = "estado") |>
mutate(estado = case_when(is.na(estado) ~ "MISSING (NA)",
estado == "" ~ "EMPTY STRING",
TRUE ~ estado))
# look at missingness across all weeks in dias
confirm_missigness <- old_data$confirm |>
select(id, volId, dias) |>
unnest(cols = dias) |>
pivot_longer(c(-id,-volId), names_to = "dia", values_to = "estado") |>
mutate(estado = case_when(is.na(estado) ~ "MISSING (NA)",
estado == "" ~ "EMPTY STRING",
TRUE ~ estado))
write_csv(confirm_missigness, "confirm_missingness.csv")
View(confirm_missigness)
